# 复制本文件为 .env（如：copy .env.example .env），再填真实值。
# 注意：.env 已被 .gitignore 忽略，不会提交到仓库，只有 .env.example 会提交。

# 服务端口
PORT=3000

# PostgreSQL 连接信息（填你自己的数据库账号密码）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campushub
DB_USER=postgres
DB_PASSWORD=postgres

# JWT 签名密钥（生产环境一定换成足够长的随机字符串）
JWT_SECRET=change-me-to-a-long-random-string
