# 复制本文件为 .env（如：copy .env.example .env），再填真实值。
# 注意：.env 已被 .gitignore 忽略，不会提交到仓库，只有 .env.example 会提交。
# 每个组员机器上各有一份自己的 .env，互不影响。

# 服务端口（server.js 从这里读取；局域网访问 http://<本机IP>:PORT）
PORT=3000

# PostgreSQL 连接信息（填你自己的数据库账号密码）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campushub
DB_USER=postgres
DB_PASSWORD=postgres

# JWT 签名密钥（生产环境一定换成足够长的随机字符串）
JWT_SECRET=change-me-to-a-long-random-string

# 阿里云短信（需在控制台申请并审核通过签名和验证码模板）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# SMTP 邮件（QQ/163/企业邮箱请使用客户端授权码）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Campus Hub <no-reply@example.com>"
